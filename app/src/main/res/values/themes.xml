<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.UnitTestDemoCompose" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.UnitTestDemo" parent="Theme.AppCompat.Light.DarkActionBar" />

    <style name="ProgressBar">
        <item name="android:indeterminateOnly">true</item>
        <item name="android:progressDrawable">@drawable/rounded_progress</item>
        <item name="android:indeterminateDrawable">@drawable/rounded_progress</item>
    </style>

    <style name="MacroHorizontalProgressBarStyle" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:max">100</item>
    </style>

</resources>