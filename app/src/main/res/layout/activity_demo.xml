<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clOrderStatusView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="9dp"
        android:animateLayoutChanges="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <!-- Order Processed Icon -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clProcessed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/imgOrderProcessed"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/grocery_with_tick_image"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Order Processed Text -->
            <TextView
                android:id="@+id/tvOrderProcessed"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Order Processed"
                android:textColor="@color/purple_700"
                android:textSize="10sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/imgOrderProcessed" />
        </androidx.constraintlayout.widget.ConstraintLayout>


        <!-- Bike Icon -->
        <ImageView
            android:id="@+id/imgBike"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_delivered_rapid"
            android:visibility="visible"
            app:layout_constraintStart_toEndOf="@id/clProcessed"
            app:layout_constraintTop_toTopOf="@id/clProcessed" />


        <com.example.unittestdemo.ui.theme.GreenLineView
            android:id="@+id/dashedLineGreen"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@id/imgBike"
            app:layout_constraintEnd_toStartOf="@id/clDelivered"
            app:layout_constraintStart_toEndOf="@id/clProcessed"
            app:layout_constraintTop_toTopOf="@id/imgBike" />


        <!-- Dashed Line -->
        <View
            android:id="@+id/dashedLine"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_dashed_line"
            app:layout_constraintBottom_toBottomOf="@id/imgBike"
            app:layout_constraintEnd_toStartOf="@id/clDelivered"
            app:layout_constraintStart_toEndOf="@id/clProcessed"
            app:layout_constraintTop_toTopOf="@id/imgBike" />

        <!-- Order Delivered Icon -->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clDelivered"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@id/clProcessed"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/clProcessed">

            <ImageView
                android:id="@+id/imgOrderDelivered"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/order_delivered_status_image"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Order Delivered Text -->
            <TextView
                android:id="@+id/tvOrderDelivered"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Order Delivered"
                android:textColor="@color/color_cool_gray"
                android:textSize="10sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/imgOrderDelivered" />
        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>


    <TextView
        android:id="@+id/tvSearch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:background="@drawable/capsule_bg"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="4dp"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        android:paddingVertical="6dp"
        android:text="Search"
        android:textColor="@color/white"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clOrderStatusView" />

    <TextView
        android:id="@+id/sonuView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:background="@drawable/bg_search_animation"
        android:drawableStart="@drawable/ic_search_small"
        android:drawablePadding="6dp"
        android:gravity="center"
        android:paddingHorizontal="30dp"
        android:paddingVertical="15dp"
        android:text="Add Products"
        android:textColor="#fff"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSearch" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sonuView">
        <ProgressBar
            style="@style/MacroHorizontalProgressBarStyle"
            android:layout_width="match_parent"
            android:progress="100"
            android:paddingHorizontal="16dp"
            android:orientation="horizontal"
            android:progressDrawable="@drawable/progress_drawable"
            android:layout_height="44dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />
        <TextView
            android:layout_width="wrap_content"
            android:text="CAPTURE"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_height="wrap_content"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

