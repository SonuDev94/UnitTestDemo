<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:name="vector"
            android:width="82dp"
            android:height="24dp"
            android:viewportWidth="82"
            android:viewportHeight="24">
            <path
                android:name="stroke"
                android:pathData="M 41 2.3 H 12 A 1 1 0 0 0 12 21.6 H 70 A 1 1 0 0 0 70 2.3 Z"
                android:strokeWidth="2"
                android:strokeColor="#000000"
                android:trimPathEnd="0">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:endX="64"
                        android:endY="0"
                        android:startX="0"
                        android:startY="0"
                        android:type="linear">
                        <item
                            android:color="#FFF54952"
                            android:offset="0" />
                        <item
                            android:color="#FF9E00"
                            android:offset="0.5" />
                        <item
                            android:color="#FFF54952"
                            android:offset="1" />
                    </gradient>
                </aapt:attr>
            </path>
            <path
                android:name="solid"
                android:fillColor="#000000"
                android:pathData="M 32 2.6 H 12.5 A 1 1 0 0 0 12 21 H 70 A 1 1 0 0 0 70 2.6 Z"
                android:strokeWidth="1"
                android:strokeColor="#FFFFFF" />
        </vector>
    </aapt:attr>
    <target android:name="stroke">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1000"
                android:interpolator="@android:anim/accelerate_decelerate_interpolator"
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <target android:name="stroke">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1000"
                android:interpolator="@android:anim/accelerate_decelerate_interpolator"
                android:propertyName="trimPathEnd"
                android:startOffset="2000"
                android:valueFrom="1"
                android:valueTo="0"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
